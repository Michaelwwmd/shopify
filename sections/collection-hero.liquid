{%- comment -%}
  Synergy Collection Hero
  Full-bleed banner with background image/color, overlay, eyebrow, big headline,
  optional body + CTA. All typography, colors, spacing and layout are
  customizable + mobile-overrideable (< 990px).
{%- endcomment -%}

<section
  class="synergy-coll-hero"
  data-section-id="{{ section.id }}"
  data-section-type="collection-hero"
  style="
    --sch-min-height: {{ section.settings.min_height }}px;
    --sch-overlay-color: {{ section.settings.overlay_color }};
    --sch-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sch-content-align: {{ section.settings.content_alignment }};
    --sch-text-align: {{ section.settings.text_alignment }};
    --sch-content-max: {{ section.settings.content_max_width }}px;
    --sch-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --sch-eyebrow-color: {{ section.settings.eyebrow_color }};
    --sch-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --sch-eyebrow-spacing: {{ section.settings.eyebrow_bottom_spacing }}px;
    --sch-heading-size: {{ section.settings.heading_font_size }}px;
    --sch-heading-color: {{ section.settings.heading_color }};
    --sch-heading-weight: {{ section.settings.heading_weight }};
    --sch-heading-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --sch-desc-size: {{ section.settings.desc_font_size }}px;
    --sch-desc-color: {{ section.settings.desc_color }};
    --sch-desc-spacing: {{ section.settings.desc_bottom_spacing }}px;
    --sch-btn-bg: {{ section.settings.button_bg_color }};
    --sch-btn-color: {{ section.settings.button_text_color }};
    --sch-btn-hover: {{ section.settings.button_hover_color }};
    --sch-btn-size: {{ section.settings.button_font_size }}px;
    --sch-btn-radius: {{ section.settings.button_border_radius }}px;
    --sch-btn-padding-v: {{ section.settings.button_padding_v }}px;
    --sch-btn-padding-h: {{ section.settings.button_padding_h }}px;

    /* Mobile overrides (applied below 990px) */
    --sch-min-height-m: {{ section.settings.min_height_m }}px;
    --sch-content-max-m: {{ section.settings.content_max_width_m }}px;
    --sch-eyebrow-size-m: {{ section.settings.eyebrow_font_size_m }}px;
    --sch-eyebrow-spacing-m: {{ section.settings.eyebrow_bottom_spacing_m }}px;
    --sch-heading-size-m: {{ section.settings.heading_font_size_m }}px;
    --sch-heading-spacing-m: {{ section.settings.heading_bottom_spacing_m }}px;
    --sch-desc-size-m: {{ section.settings.desc_font_size_m }}px;
    --sch-desc-spacing-m: {{ section.settings.desc_bottom_spacing_m }}px;
    --sch-btn-size-m: {{ section.settings.button_font_size_m }}px;
    --sch-btn-radius-m: {{ section.settings.button_border_radius_m }}px;
    --sch-btn-padding-v-m: {{ section.settings.button_padding_v_m }}px;
    --sch-btn-padding-h-m: {{ section.settings.button_padding_h_m }}px;
  "
>
  <div class="synergy-coll-hero__media">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1800, 2400',
          sizes: '100vw',
          alt: section.settings.heading | default: collection.title | escape
      }}
    {%- else -%}
      <div class="synergy-coll-hero__placeholder" style="background: {{ section.settings.bg_color }};"></div>
    {%- endif -%}
    <div class="synergy-coll-hero__overlay"></div>
  </div>

  <div class="synergy-coll-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="synergy-coll-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- assign heading_text = section.settings.heading | default: collection.title -%}
    {%- if heading_text != blank -%}
      <h1 class="synergy-coll-hero__heading">{{ heading_text }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="synergy-coll-hero__desc rte">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a
        class="synergy-coll-hero__btn"
        href="{{ section.settings.button_link | default: '#' }}"
      >
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Synergy Collection Hero",
  "tag": "section",
  "class": "section-synergy-coll-hero",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Fallback background color", "default": "#111111" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 200, "max": 800, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 300, "max": 1100, "step": 10, "unit": "px", "default": 720 },
    { "type": "select", "id": "content_alignment", "label": "Content alignment (horizontal)", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },

    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },

    { "type": "header", "content": "Eyebrow" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "PICK YOUR MODEL IS MADE FOR YOU" },
    { "type": "range", "id": "eyebrow_font_size", "label": "Eyebrow font size", "min": 10, "max": 32, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "eyebrow_weight", "label": "Eyebrow font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }], "default": "700" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#ffffff" },
    { "type": "range", "id": "eyebrow_bottom_spacing", "label": "Eyebrow bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title.", "default": "CORNHOLE BOARDS" },
    { "type": "range", "id": "heading_font_size", "label": "Heading font size", "min": 20, "max": 100, "step": 1, "unit": "px", "default": 68 },
    { "type": "select", "id": "heading_weight", "label": "Heading font weight", "options": [{ "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "heading_bottom_spacing", "label": "Heading bottom spacing", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 18 },

    { "type": "header", "content": "Description" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "" },
    { "type": "range", "id": "desc_font_size", "label": "Description font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "desc_color", "label": "Description color", "default": "#ffffff" },
    { "type": "range", "id": "desc_bottom_spacing", "label": "Description bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "LEARN MORE" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#b91c1c" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover background", "default": "#991b1b" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "button_font_size", "label": "Button font size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "button_padding_v", "label": "Button vertical padding", "min": 6, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_padding_h", "label": "Button horizontal padding", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 26 },

    { "type": "header", "content": "Mobile overrides", "info": "Applied below 990px viewport width." },
    { "type": "range", "id": "min_height_m", "label": "Minimum height (mobile)", "min": 160, "max": 800, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "content_max_width_m", "label": "Content max width (mobile)", "min": 240, "max": 1100, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "eyebrow_font_size_m", "label": "Eyebrow font size (mobile)", "min": 10, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "eyebrow_bottom_spacing_m", "label": "Eyebrow bottom spacing (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "heading_font_size_m", "label": "Heading font size (mobile)", "min": 20, "max": 100, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_bottom_spacing_m", "label": "Heading bottom spacing (mobile)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "desc_font_size_m", "label": "Description font size (mobile)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "desc_bottom_spacing_m", "label": "Description bottom spacing (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_font_size_m", "label": "Button font size (mobile)", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "button_border_radius_m", "label": "Button border radius (mobile)", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "button_padding_v_m", "label": "Button vertical padding (mobile)", "min": 6, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "button_padding_h_m", "label": "Button horizontal padding (mobile)", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 20 }
  ],
  "presets": [
    {
      "name": "Synergy Collection Hero",
      "category": "Collection"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
