{%- comment -%}
  Synergy Collection Category Chips
  Horizontal row of linked chips (small image + label). Each chip is a block so
  the store owner can add / remove / reorder them from the theme editor.
  Scrolls horizontally on mobile when it overflows.
{%- endcomment -%}

<section
  class="synergy-chips"
  data-section-id="{{ section.id }}"
  data-section-type="coll-chips"
  style="
    background-color: {{ section.settings.bg_color }};
    --scc-bg: {{ section.settings.bg_color }};
    --scc-border-color: {{ section.settings.border_color }};
    --scc-padding-top: {{ section.settings.padding_top }}px;
    --scc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --scc-gap: {{ section.settings.item_gap }}px;
    --scc-icon-size: {{ section.settings.icon_size }}px;
    --scc-icon-radius: {{ section.settings.icon_border_radius }}px;
    --scc-icon-spacing: {{ section.settings.icon_bottom_spacing }}px;
    --scc-label-size: {{ section.settings.label_font_size }}px;
    --scc-label-color: {{ section.settings.label_color }};
    --scc-label-weight: {{ section.settings.label_weight }};
    --scc-label-letter: {{ section.settings.label_letter_spacing }}em;

    /* Mobile overrides (< 990px) */
    --scc-padding-top-m: {{ section.settings.padding_top_m }}px;
    --scc-padding-bottom-m: {{ section.settings.padding_bottom_m }}px;
    --scc-gap-m: {{ section.settings.item_gap_m }}px;
    --scc-icon-size-m: {{ section.settings.icon_size_m }}px;
    --scc-icon-spacing-m: {{ section.settings.icon_bottom_spacing_m }}px;
    --scc-label-size-m: {{ section.settings.label_font_size_m }}px;
  "
>
  <div class="synergy-chips__wrap page-width">
    <ul class="synergy-chips__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'chip' -%}
          {%- assign chip_link = block.settings.link | default: '#' -%}
          <li class="synergy-chips__item" {{ block.shopify_attributes }}>
            <a class="synergy-chips__link" href="{{ chip_link }}">
              <span class="synergy-chips__icon">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.label | escape }}
                {%- else -%}
                  <span class="synergy-chips__placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </span>
              <span class="synergy-chips__label">{{ block.settings.label }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Category Chips",
  "tag": "section",
  "class": "section-synergy-chips",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Top / bottom border color", "default": "#e5e7eb" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "item_gap", "label": "Gap between chips", "min": 6, "max": 60, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Icons" },
    { "type": "range", "id": "icon_size", "label": "Icon max size", "min": 40, "max": 160, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "icon_border_radius", "label": "Icon border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "icon_bottom_spacing", "label": "Icon bottom spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 8 },

    { "type": "header", "content": "Labels" },
    { "type": "range", "id": "label_font_size", "label": "Label font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "select", "id": "label_weight", "label": "Label font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }], "default": "700" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#111111" },
    { "type": "range", "id": "label_letter_spacing", "label": "Label letter spacing", "min": 0, "max": 0.3, "step": 0.01, "default": 0.05 },

    { "type": "header", "content": "Mobile overrides", "info": "Applied below 990px viewport width. The row becomes horizontally scrollable on narrow screens." },
    { "type": "range", "id": "padding_top_m", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_bottom_m", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "item_gap_m", "label": "Gap between chips (mobile)", "min": 6, "max": 60, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "icon_size_m", "label": "Icon max size (mobile)", "min": 32, "max": 160, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "icon_bottom_spacing_m", "label": "Icon bottom spacing (mobile)", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "label_font_size_m", "label": "Label font size (mobile)", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Category chip",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image" },
        { "type": "text", "id": "label", "label": "Label", "default": "ALL WEATHER" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Synergy Category Chips",
      "category": "Collection",
      "blocks": [
        { "type": "chip", "settings": { "label": "ALL WEATHER" } },
        { "type": "chip", "settings": { "label": "GOLD SERIES" } },
        { "type": "chip", "settings": { "label": "SILVER SERIES" } },
        { "type": "chip", "settings": { "label": "STAR-U" } },
        { "type": "chip", "settings": { "label": "CUSTOM" } },
        { "type": "chip", "settings": { "label": "DO IT YOURSELF" } },
        { "type": "chip", "settings": { "label": "BACKYARD 2400" } },
        { "type": "chip", "settings": { "label": "BACKYARD 1500" } }
      ]
    }
  ]
}
{% endschema %}
