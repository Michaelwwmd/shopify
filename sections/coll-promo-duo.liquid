{%- comment -%}
  Synergy Collection Promo Duo
  Two side-by-side promo banners (each with background image, overlay, eyebrow,
  heading, and CTA). Blocks so you can add up to 4 columns (stacks on mobile).
{%- endcomment -%}

<section
  class="synergy-promo-duo"
  data-section-id="{{ section.id }}"
  data-section-type="coll-promo-duo"
  style="
    background-color: {{ section.settings.bg_color }};
    --spd-bg: {{ section.settings.bg_color }};
    --spd-padding-top: {{ section.settings.padding_top }}px;
    --spd-padding-bottom: {{ section.settings.padding_bottom }}px;
    --spd-gap: {{ section.settings.column_gap }}px;
    --spd-card-min-height: {{ section.settings.card_min_height }}px;
    --spd-card-radius: {{ section.settings.card_border_radius }}px;
    --spd-overlay-color: {{ section.settings.overlay_color }};
    --spd-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --spd-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --spd-eyebrow-color: {{ section.settings.eyebrow_color }};
    --spd-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --spd-eyebrow-spacing: {{ section.settings.eyebrow_bottom_spacing }}px;
    --spd-heading-size: {{ section.settings.heading_font_size }}px;
    --spd-heading-color: {{ section.settings.heading_color }};
    --spd-heading-weight: {{ section.settings.heading_weight }};
    --spd-heading-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --spd-btn-bg: {{ section.settings.button_bg_color }};
    --spd-btn-color: {{ section.settings.button_text_color }};
    --spd-btn-hover: {{ section.settings.button_hover_color }};
    --spd-btn-size: {{ section.settings.button_font_size }}px;
    --spd-btn-radius: {{ section.settings.button_border_radius }}px;
    --spd-btn-padding-v: {{ section.settings.button_padding_v }}px;
    --spd-btn-padding-h: {{ section.settings.button_padding_h }}px;

    /* Mobile overrides (< 990px) */
    --spd-padding-top-m: {{ section.settings.padding_top_m }}px;
    --spd-padding-bottom-m: {{ section.settings.padding_bottom_m }}px;
    --spd-gap-m: {{ section.settings.column_gap_m }}px;
    --spd-card-min-height-m: {{ section.settings.card_min_height_m }}px;
    --spd-eyebrow-size-m: {{ section.settings.eyebrow_font_size_m }}px;
    --spd-eyebrow-spacing-m: {{ section.settings.eyebrow_bottom_spacing_m }}px;
    --spd-heading-size-m: {{ section.settings.heading_font_size_m }}px;
    --spd-heading-spacing-m: {{ section.settings.heading_bottom_spacing_m }}px;
    --spd-btn-size-m: {{ section.settings.button_font_size_m }}px;
    --spd-btn-padding-v-m: {{ section.settings.button_padding_v_m }}px;
    --spd-btn-padding-h-m: {{ section.settings.button_padding_h_m }}px;
  "
>
  <div class="synergy-promo-duo__wrap page-width">
    <div class="synergy-promo-duo__grid" data-columns="{{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <article class="synergy-promo-duo__card" {{ block.shopify_attributes }}>
            <div class="synergy-promo-duo__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 700, 1000, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: block.settings.heading | escape
                }}
              {%- endif -%}
              <div class="synergy-promo-duo__overlay"></div>
            </div>
            <div class="synergy-promo-duo__body">
              {%- if block.settings.eyebrow != blank -%}
                <p class="synergy-promo-duo__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="synergy-promo-duo__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                <a
                  class="synergy-promo-duo__btn"
                  href="{{ block.settings.button_link | default: '#' }}"
                >
                  {{ block.settings.button_text }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Promo Duo",
  "tag": "section",
  "class": "section-synergy-promo-duo",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "column_gap", "label": "Gap between cards", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 180 },
    { "type": "range", "id": "card_border_radius", "label": "Card border radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },

    { "type": "header", "content": "Overlay" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },

    { "type": "header", "content": "Eyebrow" },
    { "type": "range", "id": "eyebrow_font_size", "label": "Eyebrow font size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "select", "id": "eyebrow_weight", "label": "Eyebrow font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }], "default": "700" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#ffffff" },
    { "type": "range", "id": "eyebrow_bottom_spacing", "label": "Eyebrow bottom spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },

    { "type": "header", "content": "Heading" },
    { "type": "range", "id": "heading_font_size", "label": "Heading font size", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 22 },
    { "type": "select", "id": "heading_weight", "label": "Heading font weight", "options": [{ "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "800" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "heading_bottom_spacing", "label": "Heading bottom spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#b91c1c" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover background", "default": "#991b1b" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "button_font_size", "label": "Button font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 3 },
    { "type": "range", "id": "button_padding_v", "label": "Button vertical padding", "min": 6, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "button_padding_h", "label": "Button horizontal padding", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 22 },

    { "type": "header", "content": "Mobile overrides", "info": "Applied below 990px viewport width. Cards stack vertically on mobile." },
    { "type": "range", "id": "padding_top_m", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_bottom_m", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "column_gap_m", "label": "Gap between cards (mobile)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_min_height_m", "label": "Card minimum height (mobile)", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "eyebrow_font_size_m", "label": "Eyebrow font size (mobile)", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "eyebrow_bottom_spacing_m", "label": "Eyebrow bottom spacing (mobile)", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "heading_font_size_m", "label": "Heading font size (mobile)", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "heading_bottom_spacing_m", "label": "Heading bottom spacing (mobile)", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "button_font_size_m", "label": "Button font size (mobile)", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "button_padding_v_m", "label": "Button vertical padding (mobile)", "min": 6, "max": 20, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "button_padding_h_m", "label": "Button horizontal padding (mobile)", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 18 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PICK YOUR PROP, CHOOSE YOUR SIDE" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "CUSTOM BOARDS THAT STAND OUT" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "START CUSTOMIZING" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Synergy Promo Duo",
      "category": "Collection",
      "blocks": [
        { "type": "card", "settings": { "eyebrow": "PICK YOUR PROP, CHOOSE YOUR SIDE", "heading": "CUSTOM BOARDS THAT STAND OUT", "button_text": "START CUSTOMIZING" } },
        { "type": "card", "settings": { "eyebrow": "BAGS YOUR WAY, THROW YOUR WAY", "heading": "CUSTOM BAGS THAT LOOK AS GOOD AS THEY FLY", "button_text": "START CUSTOMIZING" } }
      ]
    }
  ]
}
{% endschema %}
