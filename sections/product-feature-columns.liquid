{%- comment -%}
  "NEW! Game Changing Edge Technology" 4-column feature section with image cards.
  All typography, colors, and spacing are customizable via the theme editor.
{%- endcomment -%}

<section
  class="synergy-features-grid"
  data-section-id="{{ section.id }}"
  data-section-type="product-feature-columns"
  style="
    background-color: {{ section.settings.bg_color }};
    --sfg-bg: {{ section.settings.bg_color }};
    --sfg-padding-top: {{ section.settings.padding_top }}px;
    --sfg-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sfg-heading-size: {{ section.settings.heading_font_size }}px;
    --sfg-heading-color: {{ section.settings.heading_color }};
    --sfg-heading-align: {{ section.settings.heading_alignment }};
    --sfg-heading-weight: {{ section.settings.heading_weight }};
    --sfg-heading-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --sfg-sub-size: {{ section.settings.subheading_font_size }}px;
    --sfg-sub-color: {{ section.settings.subheading_color }};
    --sfg-sub-spacing: {{ section.settings.subheading_bottom_spacing }}px;
    --sfg-columns: {{ section.settings.columns_desktop }};
    --sfg-column-gap: {{ section.settings.column_gap }}px;
    --sfg-row-gap: {{ section.settings.row_gap }}px;
    --sfg-card-align: {{ section.settings.card_text_alignment }};
    --sfg-title-size: {{ section.settings.card_title_font_size }}px;
    --sfg-title-color: {{ section.settings.card_title_color }};
    --sfg-title-weight: {{ section.settings.card_title_weight }};
    --sfg-title-spacing: {{ section.settings.card_title_bottom_spacing }}px;
    --sfg-desc-size: {{ section.settings.card_desc_font_size }}px;
    --sfg-desc-color: {{ section.settings.card_desc_color }};
    --sfg-desc-weight: {{ section.settings.card_desc_weight }};
    --sfg-desc-line-height: {{ section.settings.card_desc_line_height }};
    --sfg-image-ratio: {{ section.settings.image_aspect_ratio }};
    --sfg-image-radius: {{ section.settings.image_border_radius }}px;
    --sfg-image-spacing: {{ section.settings.image_bottom_spacing }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="synergy-features-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="synergy-features-grid__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="synergy-features-grid__row">
      {%- for block in section.blocks -%}
        <div
          class="synergy-features-grid__item"
          {{ block.shopify_attributes }}
          {% if block.settings.title_color_override != blank or block.settings.desc_color_override != blank %}
            style="
              {%- if block.settings.title_color_override != blank -%}--sfg-title-color: {{ block.settings.title_color_override }};{%- endif -%}
              {%- if block.settings.desc_color_override != blank -%}--sfg-desc-color: {{ block.settings.desc_color_override }};{%- endif -%}
            "
          {% endif %}
        >
          <div class="synergy-features-grid__image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="synergy-features-grid__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="synergy-features-grid__desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Feature Columns",
  "tag": "section",
  "class": "section-synergy-features-grid",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW! GAME CHANGING EDGE TECHNOLOGY"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "900"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section subheading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bomber Synergy Edge bags give you the edge with Edge Technology stitching."
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#6c757d"
    },
    {
      "type": "range",
      "id": "subheading_bottom_spacing",
      "label": "Subheading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card images"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "auto", "label": "Natural (auto)" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "image_bottom_spacing",
      "label": "Image bottom spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card titles"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "label": "Title font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "card_title_weight",
      "label": "Title font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "800"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "card_title_bottom_spacing",
      "label": "Title bottom spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Card descriptions"
    },
    {
      "type": "range",
      "id": "card_desc_font_size",
      "label": "Description font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "card_desc_weight",
      "label": "Description font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Description color",
      "default": "#6c757d"
    },
    {
      "type": "select",
      "id": "card_desc_line_height",
      "label": "Description line height",
      "options": [
        { "value": "1.2", "label": "Tight (1.2)" },
        { "value": "1.4", "label": "Normal (1.4)" },
        { "value": "1.6", "label": "Relaxed (1.6)" },
        { "value": "1.8", "label": "Loose (1.8)" }
      ],
      "default": "1.6"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "DUAL-TONE GRIP BACK"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Custom finishes in Sahara color so you'll always know which side is up."
        },
        {
          "type": "header",
          "content": "Per-card overrides"
        },
        {
          "type": "color",
          "id": "title_color_override",
          "label": "Title color override",
          "info": "Leave blank to use section default."
        },
        {
          "type": "color",
          "id": "desc_color_override",
          "label": "Description color override",
          "info": "Leave blank to use section default."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Synergy Feature Columns",
      "category": "Product",
      "blocks": [
        { "type": "feature", "settings": { "title": "DUAL-TONE GRIP BACK" } },
        { "type": "feature", "settings": { "title": "A 90 BREAK BAG AND A SLIDE" } },
        { "type": "feature", "settings": { "title": "COMFORTABLE RELEASE, LANDS FIRST PLAY" } },
        { "type": "feature", "settings": { "title": "BUILT FOR THE FINAL WORD" } }
      ]
    }
  ]
}
{% endschema %}
