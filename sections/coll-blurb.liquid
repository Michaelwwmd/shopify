{%- comment -%}
  Synergy Collection Blurb
  Bottom-of-page editorial block: small eyebrow + large heading + rich text body.
  Typically used for collection SEO copy ("Why choose official ACA cornhole boards?").
{%- endcomment -%}

<section
  class="synergy-blurb"
  data-section-id="{{ section.id }}"
  data-section-type="coll-blurb"
  style="
    background-color: {{ section.settings.bg_color }};
    --sb-bg: {{ section.settings.bg_color }};
    --sb-padding-top: {{ section.settings.padding_top }}px;
    --sb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sb-max-width: {{ section.settings.max_width }}px;
    --sb-text-align: {{ section.settings.text_alignment }};
    --sb-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --sb-eyebrow-color: {{ section.settings.eyebrow_color }};
    --sb-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --sb-eyebrow-spacing: {{ section.settings.eyebrow_bottom_spacing }}px;
    --sb-eyebrow-letter: {{ section.settings.eyebrow_letter_spacing }}em;
    --sb-heading-size: {{ section.settings.heading_font_size }}px;
    --sb-heading-color: {{ section.settings.heading_color }};
    --sb-heading-weight: {{ section.settings.heading_weight }};
    --sb-heading-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --sb-body-size: {{ section.settings.body_font_size }}px;
    --sb-body-color: {{ section.settings.body_color }};
    --sb-body-line-height: {{ section.settings.body_line_height }};

    /* Mobile overrides (< 990px) */
    --sb-padding-top-m: {{ section.settings.padding_top_m }}px;
    --sb-padding-bottom-m: {{ section.settings.padding_bottom_m }}px;
    --sb-max-width-m: {{ section.settings.max_width_m }}px;
    --sb-eyebrow-size-m: {{ section.settings.eyebrow_font_size_m }}px;
    --sb-eyebrow-spacing-m: {{ section.settings.eyebrow_bottom_spacing_m }}px;
    --sb-heading-size-m: {{ section.settings.heading_font_size_m }}px;
    --sb-heading-spacing-m: {{ section.settings.heading_bottom_spacing_m }}px;
    --sb-body-size-m: {{ section.settings.body_font_size_m }}px;
  "
>
  <div class="synergy-blurb__wrap page-width">
    <div class="synergy-blurb__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="synergy-blurb__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="synergy-blurb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="synergy-blurb__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Collection Blurb",
  "tag": "section",
  "class": "section-synergy-blurb",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 400, "max": 1200, "step": 20, "unit": "px", "default": 980 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },

    { "type": "header", "content": "Eyebrow" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY CHOOSE OFFICIAL ACA CORNHOLE BOARDS?" },
    { "type": "range", "id": "eyebrow_font_size", "label": "Eyebrow font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "select", "id": "eyebrow_weight", "label": "Eyebrow font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }], "default": "700" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#6c757d" },
    { "type": "range", "id": "eyebrow_bottom_spacing", "label": "Eyebrow bottom spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Eyebrow letter spacing", "min": 0, "max": 0.3, "step": 0.01, "default": 0.08 },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CORNHOLE BOARDS" },
    { "type": "range", "id": "heading_font_size", "label": "Heading font size", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 32 },
    { "type": "select", "id": "heading_weight", "label": "Heading font weight", "options": [{ "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "heading_bottom_spacing", "label": "Heading bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "Body" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Are official ACA cornhole boards really the best cornhole boards? Why should they be your next cornhole boards? Maybe it’s the premium construction materials. Or the attention to detailed engineering. It could be the vibrant colors of the stunning designs.</p><p>Whatever it is, our customer reviews are a testament to our rich American heritage.</p>" },
    { "type": "range", "id": "body_font_size", "label": "Body font size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#333333" },
    { "type": "select", "id": "body_line_height", "label": "Body line height", "options": [{ "value": "1.4", "label": "Tight" }, { "value": "1.6", "label": "Normal" }, { "value": "1.7", "label": "Relaxed" }, { "value": "1.9", "label": "Loose" }], "default": "1.7" },

    { "type": "header", "content": "Mobile overrides", "info": "Applied below 990px viewport width." },
    { "type": "range", "id": "padding_top_m", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_m", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "max_width_m", "label": "Content max width (mobile)", "min": 280, "max": 1200, "step": 10, "unit": "px", "default": 700 },
    { "type": "range", "id": "eyebrow_font_size_m", "label": "Eyebrow font size (mobile)", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "eyebrow_bottom_spacing_m", "label": "Eyebrow bottom spacing (mobile)", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "heading_font_size_m", "label": "Heading font size (mobile)", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_bottom_spacing_m", "label": "Heading bottom spacing (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "body_font_size_m", "label": "Body font size (mobile)", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 }
  ],
  "presets": [
    {
      "name": "Synergy Collection Blurb",
      "category": "Collection"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
