{%- comment -%}
  Trust badges row — fully customizable.
{%- endcomment -%}

<section
  class="synergy-badges"
  data-section-id="{{ section.id }}"
  data-section-type="product-trust-badges"
  style="
    background-color: {{ section.settings.bg_color }};
    --stb-bg: {{ section.settings.bg_color }};
    --stb-padding-top: {{ section.settings.padding_top }}px;
    --stb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --stb-border-color: {{ section.settings.border_color }};
    --stb-columns: {{ section.blocks.size | at_least: 1 }};
    --stb-gap: {{ section.settings.column_gap }}px;
    --stb-icon-size: {{ section.settings.icon_size }}px;
    --stb-label-size: {{ section.settings.label_font_size }}px;
    --stb-label-color: {{ section.settings.label_color }};
    --stb-label-weight: {{ section.settings.label_weight }};
    --stb-icon-spacing: {{ section.settings.icon_bottom_spacing }}px;
  "
>
  <div class="page-width">
    <div class="synergy-badges__row">
      {%- for block in section.blocks -%}
        <div class="synergy-badges__item" {{ block.shopify_attributes }}>
          <div class="synergy-badges__icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 180 | image_tag: loading: 'lazy', alt: block.settings.label | escape }}
            {%- endif -%}
          </div>
          <p class="synergy-badges__label">{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Trust Badges",
  "tag": "section",
  "class": "section-synergy-badges",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "color", "id": "border_color", "label": "Top / bottom border color", "default": "#e5e7eb" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Icons" },
    { "type": "range", "id": "icon_size", "label": "Icon max width", "min": 40, "max": 200, "step": 2, "unit": "px", "default": 120 },
    { "type": "range", "id": "icon_bottom_spacing", "label": "Icon bottom spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 10 },
    { "type": "header", "content": "Labels" },
    { "type": "range", "id": "label_font_size", "label": "Label font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "select", "id": "label_weight", "label": "Label font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }], "default": "800" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "label", "label": "Label", "default": "EDGE TECHNOLOGY" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Synergy Trust Badges",
      "category": "Product",
      "blocks": [
        { "type": "badge", "settings": { "label": "EDGE TECHNOLOGY" } },
        { "type": "badge", "settings": { "label": "OFFICIAL ACA APPROVAL" } },
        { "type": "badge", "settings": { "label": "30 DAY RISK-FREE 100% SATISFACTION GUARANTEE" } }
      ]
    }
  ]
}
{% endschema %}
