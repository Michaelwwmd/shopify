{%- comment -%}
  "GET AN EDGE OVER THE COMPETITION" CTA banner — fully customizable.
{%- endcomment -%}

<section
  class="synergy-cta"
  data-section-id="{{ section.id }}"
  data-section-type="product-cta-edge"
  style="
    --sc-min-height: {{ section.settings.min_height }}px;
    --sc-overlay-color: {{ section.settings.overlay_color }};
    --sc-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sc-content-align: {{ section.settings.content_alignment }};
    --sc-content-max: {{ section.settings.content_max_width }}px;
    --sc-heading-size: {{ section.settings.heading_font_size }}px;
    --sc-heading-color: {{ section.settings.heading_color }};
    --sc-heading-weight: {{ section.settings.heading_weight }};
    --sc-heading-spacing: {{ section.settings.heading_bottom_spacing }}px;
    --sc-desc-size: {{ section.settings.desc_font_size }}px;
    --sc-desc-color: {{ section.settings.desc_color }};
    --sc-desc-line-height: {{ section.settings.desc_line_height }};
    --sc-btn-bg: {{ section.settings.button_bg_color }};
    --sc-btn-color: {{ section.settings.button_text_color }};
    --sc-btn-size: {{ section.settings.button_font_size }}px;
    --sc-btn-radius: {{ section.settings.button_border_radius }}px;
    --sc-btn-padding-v: {{ section.settings.button_padding_v }}px;
    --sc-btn-padding-h: {{ section.settings.button_padding_h }}px;
  "
>
  <div class="synergy-cta__media">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading | escape }}
    {%- endif -%}
    <div class="synergy-cta__overlay"></div>
  </div>
  <div class="synergy-cta__content page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="synergy-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="synergy-cta__description">{{ section.settings.description }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="synergy-cta__button btn">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Synergy CTA Banner",
  "tag": "section",
  "class": "section-synergy-cta",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#8b0000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 200, "max": 700, "step": 10, "unit": "px", "default": 420 },
    { "type": "header", "content": "Content layout" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }], "default": "flex-start" },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 720 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GET AN EDGE OVER THE COMPETITION" },
    { "type": "range", "id": "heading_font_size", "label": "Heading font size", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 36 },
    { "type": "select", "id": "heading_weight", "label": "Heading font weight", "options": [{ "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "heading_bottom_spacing", "label": "Heading bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Description" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "range", "id": "desc_font_size", "label": "Description font size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "desc_color", "label": "Description color", "default": "#ffffff" },
    { "type": "select", "id": "desc_line_height", "label": "Description line height", "options": [{ "value": "1.3", "label": "Tight" }, { "value": "1.5", "label": "Normal" }, { "value": "1.7", "label": "Relaxed" }], "default": "1.5" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#111111" },
    { "type": "range", "id": "button_font_size", "label": "Button font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "button_padding_v", "label": "Button vertical padding", "min": 6, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_padding_h", "label": "Button horizontal padding", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 30 }
  ],
  "presets": [
    {
      "name": "Synergy CTA Banner",
      "category": "Product"
    }
  ]
}
{% endschema %}
