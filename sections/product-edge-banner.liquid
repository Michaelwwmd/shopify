{%- comment -%}
  "Introducing the new Synergy Edge" dark banner with product image.
{%- endcomment -%}

<section
  class="synergy-edge-banner"
  data-section-id="{{ section.id }}"
  data-section-type="product-edge-banner"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="synergy-edge-banner__inner">
      <p class="synergy-edge-banner__eyebrow">{{ section.settings.heading }}</p>
      <h2 class="synergy-edge-banner__title">{{ section.settings.subheading }}</h2>
      {%- if section.settings.image != blank -%}
        <div class="synergy-edge-banner__image">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.subheading | escape }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Edge Banner",
  "tag": "section",
  "class": "section-synergy-edge-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Eyebrow text",
      "default": "INTRODUCING THE NEW"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Headline",
      "default": "SYNERGY EDGE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Synergy Edge Banner",
      "category": "Product"
    }
  ]
}
{% endschema %}
