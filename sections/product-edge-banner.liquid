{%- comment -%}
  "Introducing the new Synergy Edge" dark banner — fully customizable.
{%- endcomment -%}

<section
  class="synergy-edge-banner"
  data-section-id="{{ section.id }}"
  data-section-type="product-edge-banner"
  style="
    background-color: {{ section.settings.bg_color }};
    --seb-bg: {{ section.settings.bg_color }};
    --seb-padding-top: {{ section.settings.padding_top }}px;
    --seb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --seb-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --seb-eyebrow-color: {{ section.settings.eyebrow_color }};
    --seb-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --seb-eyebrow-spacing: {{ section.settings.eyebrow_letter_spacing }};
    --seb-title-size: {{ section.settings.title_font_size }}px;
    --seb-title-color: {{ section.settings.title_color }};
    --seb-title-weight: {{ section.settings.title_weight }};
    --seb-title-spacing: {{ section.settings.title_bottom_spacing }}px;
    --seb-align: {{ section.settings.text_alignment }};
    --seb-image-max: {{ section.settings.image_max_width }}px;
  "
>
  <div class="page-width">
    <div class="synergy-edge-banner__inner">
      {%- if section.settings.heading != blank -%}
        <p class="synergy-edge-banner__eyebrow">{{ section.settings.heading }}</p>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <h2 class="synergy-edge-banner__title">{{ section.settings.subheading }}</h2>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        <div class="synergy-edge-banner__image">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.subheading | escape }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Edge Banner",
  "tag": "section",
  "class": "section-synergy-edge-banner",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#111111" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 150, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 150, "step": 2, "unit": "px", "default": 60 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "header", "content": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Eyebrow text", "default": "INTRODUCING THE NEW" },
    { "type": "range", "id": "eyebrow_font_size", "label": "Eyebrow font size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "select", "id": "eyebrow_weight", "label": "Eyebrow font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#cccccc" },
    { "type": "select", "id": "eyebrow_letter_spacing", "label": "Eyebrow letter spacing", "options": [{ "value": "0em", "label": "None" }, { "value": "0.05em", "label": "Tight (0.05em)" }, { "value": "0.1em", "label": "Normal (0.1em)" }, { "value": "0.15em", "label": "Wide (0.15em)" }, { "value": "0.2em", "label": "Wider (0.2em)" }, { "value": "0.3em", "label": "Extra wide (0.3em)" }], "default": "0.2em" },
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "subheading", "label": "Headline", "default": "SYNERGY EDGE" },
    { "type": "range", "id": "title_font_size", "label": "Headline font size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "select", "id": "title_weight", "label": "Headline font weight", "options": [{ "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "title_color", "label": "Headline color", "default": "#ffffff" },
    { "type": "range", "id": "title_bottom_spacing", "label": "Headline bottom spacing", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "image_max_width", "label": "Image max width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 900 }
  ],
  "presets": [
    {
      "name": "Synergy Edge Banner",
      "category": "Product"
    }
  ]
}
{% endschema %}
