{{ 'custom-synergy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-synergy.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section
  class="synergy-product"
  data-section-id="{{ section.id }}"
  data-section-type="main-product-synergy"
>
  <div class="synergy-product__wrapper page-width">
    {%- comment -%} ---- Gallery ---- {%- endcomment -%}
    <div class="synergy-product__gallery">
      <div class="synergy-gallery" data-synergy-gallery>
        <div class="synergy-gallery__thumbs" data-synergy-thumbs>
          {%- for media in product.media -%}
            <button
              type="button"
              class="synergy-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ media.alt | default: product.title | escape }}"
            >
              {%- if media.media_type == 'image' -%}
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>

        <div class="synergy-gallery__stage" data-synergy-stage>
          {%- if section.settings.image_badge_label != blank -%}
            <span class="synergy-gallery__badge">{{ section.settings.image_badge_label }}</span>
          {%- endif -%}

          {%- for media in product.media -%}
            <div
              class="synergy-gallery__slide{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'eager',
                      widths: '480, 720, 960, 1200, 1600',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: media.alt | escape
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | image_url: width: 1200 | image_tag: alt: media.alt | escape }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ---- Product Info ---- {%- endcomment -%}
    <div class="synergy-product__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="synergy-product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="synergy-product__title">{{ product.title | upcase }}</h1>

      {%- comment -%} ---- Star rating ---- {%- endcomment -%}
      <div class="synergy-product__rating">
        <div class="synergy-stars" aria-label="Rated {{ section.settings.review_rating }} out of 5">
          <span class="synergy-stars__fill" style="width: {{ section.settings.review_rating | times: 20.0 }}%;"></span>
        </div>
        <a href="#synergy-reviews" class="synergy-product__rating-count">
          {{ section.settings.review_count_text }}
        </a>
      </div>

      <div class="synergy-product__price-row">
        <div class="synergy-product__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="synergy-product__price-compare">
              {{ current_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
          <span class="synergy-product__price-current" data-synergy-price>
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="synergy-product__price-save">
              Save
              {{- current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- endif -%}
        </div>

        {%- comment -%} Tax / shipping micro-line {%- endcomment -%}
        {%- if section.settings.tax_shipping_text != blank -%}
          <p class="synergy-product__tax-note">{{ section.settings.tax_shipping_text }}</p>
        {%- endif -%}

        {%- comment -%} Installment messaging (Shop Pay / Afterpay / Klarna) {%- endcomment -%}
        {%- if section.settings.enable_installments -%}
          <p class="synergy-product__installments">
            or 4 interest-free installments of
            <strong>{{ current_variant.price | divided_by: 4.0 | money }}</strong>
            by
            <span class="synergy-product__installments-brand">{{ section.settings.installment_brand }}</span>
            <a href="{{ section.settings.installment_link }}" class="synergy-product__installments-learn">Learn more</a>
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Short description / highlights ---- {%- endcomment -%}
      {%- if section.settings.short_description != blank -%}
        <div class="synergy-product__blurb rte">
          {{ section.settings.short_description }}
        </div>
      {%- endif -%}

      {%- comment -%} ---- Variant form ---- {%- endcomment -%}
      {%- form 'product', product, class: 'synergy-product__form', id: 'synergy-product-form', novalidate: 'novalidate' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="synergy-product__option" data-option-index="{{ forloop.index0 }}">
              <label class="synergy-product__option-label">
                {{ option.name }}:
                <span class="synergy-product__option-value" data-option-value="{{ forloop.index0 }}">
                  {{ option.selected_value }}
                </span>
              </label>
              <div class="synergy-product__swatches" data-option-swatches>
                {%- for value in option.values -%}
                  {%- assign is_color = false -%}
                  {%- assign lower_name = option.name | downcase -%}
                  {%- if lower_name contains 'color' or lower_name contains 'colour' -%}
                    {%- assign is_color = true -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="synergy-swatch{% if option.selected_value == value %} is-active{% endif %}{% if is_color %} is-color{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-option-value="{{ value | escape }}"
                    {% if is_color %}style="background-color: {{ value | handle }};"{% endif %}
                    aria-label="{{ option.name }}: {{ value }}"
                  >
                    {%- unless is_color -%}{{ value }}{%- endunless -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <select name="id" class="synergy-product__variant-select" data-synergy-variant-select hidden>
          {%- for variant in product.variants -%}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected="selected"{% endif %}
              {% unless variant.available %}disabled{% endunless %}
              data-price="{{ variant.price | money }}"
              data-compare-price="{{ variant.compare_at_price | money }}"
              data-available="{{ variant.available }}"
            >
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>

        <div class="synergy-product__qty-row">
          <div class="synergy-product__qty">
            <label class="synergy-product__qty-label" for="synergy-quantity">Qty:</label>
            <div class="synergy-qty-input">
              <button type="button" class="synergy-qty-input__btn" data-qty-action="decrement" aria-label="Decrease quantity">&minus;</button>
              <input
                type="number"
                id="synergy-quantity"
                name="quantity"
                value="1"
                min="1"
                class="synergy-qty-input__field"
                data-synergy-qty
              >
              <button type="button" class="synergy-qty-input__btn" data-qty-action="increment" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            class="synergy-product__atc btn"
            data-synergy-atc
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span class="synergy-product__atc-text">
              {%- if current_variant.available -%}
                {{ section.settings.atc_label | default: 'ADD TO CART' }}
              {%- else -%}
                SOLD OUT
              {%- endif -%}
            </span>
            {%- if section.settings.atc_sublabel != blank -%}
              <span class="synergy-product__atc-sublabel">{{ section.settings.atc_sublabel }}</span>
            {%- endif -%}
          </button>
        </div>

        {%- if section.settings.enable_payment_button -%}
          <div class="synergy-product__dynamic-checkout">
            {{ form | payment_button }}
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} ---- SKU + stock ---- {%- endcomment -%}
      <div class="synergy-product__meta">
        {%- if section.settings.show_sku and current_variant.sku != blank -%}
          <span class="synergy-product__sku">SKU: {{ current_variant.sku }}</span>
        {%- endif -%}
        {%- if section.settings.show_stock -%}
          {%- if current_variant.available -%}
            <span class="synergy-product__stock synergy-product__stock--in">
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/></svg>
              In stock, ready to ship
            </span>
          {%- else -%}
            <span class="synergy-product__stock synergy-product__stock--out">Out of stock</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} ---- Trust icon row ---- {%- endcomment -%}
      {%- assign has_trust = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_icon' -%}{%- assign has_trust = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_trust -%}
        <ul class="synergy-product__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_icon' -%}
              <li class="synergy-product__trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="synergy-product__trust-icon">
                    {{ block.settings.icon | image_url: width: 60 | image_tag: loading: 'lazy', alt: block.settings.label | escape }}
                  </span>
                {%- else -%}
                  <span class="synergy-product__trust-icon synergy-product__trust-icon--default" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <path d="M20.3 5.7a1 1 0 0 1 0 1.4l-10 10a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4L9.6 15 18.9 5.7a1 1 0 0 1 1.4 0z" fill="currentColor"/>
                    </svg>
                  </span>
                {%- endif -%}
                <span class="synergy-product__trust-label">{{ block.settings.label }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ---- Complete Your Set ---- {%- endcomment -%}
    {%- if section.settings.enable_complete_your_set -%}
      <aside class="synergy-product__upsell">
        <h3 class="synergy-product__upsell-heading">
          {{ section.settings.complete_your_set_heading }}
        </h3>
        <div class="synergy-product__upsell-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'upsell_product' -%}
              {%- assign upsell = all_products[block.settings.product] -%}
              {%- if upsell != blank -%}
                <a href="{{ upsell.url }}" class="synergy-upsell-card" {{ block.shopify_attributes }}>
                  <div class="synergy-upsell-card__image">
                    {%- if upsell.featured_image -%}
                      {{ upsell.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: upsell.title | escape }}
                    {%- endif -%}
                  </div>
                  <div class="synergy-upsell-card__body">
                    <p class="synergy-upsell-card__title">{{ upsell.title }}</p>
                    <div class="synergy-upsell-card__rating">
                      <div class="synergy-stars synergy-stars--sm">
                        <span class="synergy-stars__fill" style="width: 100%;"></span>
                      </div>
                    </div>
                    <p class="synergy-upsell-card__price">{{ upsell.price | money }}</p>
                  </div>
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Synergy Product",
  "tag": "section",
  "class": "section-synergy-product",
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "text",
      "id": "image_badge_label",
      "label": "Gallery badge label",
      "info": "e.g. NEW, BEST SELLER",
      "default": "NEW"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "range",
      "id": "review_rating",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.7
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "147 reviews"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "tax_shipping_text",
      "label": "Tax / shipping micro-line",
      "default": "Tax included. Shipping calculated at checkout."
    },
    {
      "type": "checkbox",
      "id": "enable_installments",
      "label": "Show installment messaging",
      "default": true
    },
    {
      "type": "text",
      "id": "installment_brand",
      "label": "Installment brand name",
      "default": "Shop Pay"
    },
    {
      "type": "url",
      "id": "installment_link",
      "label": "\"Learn more\" link"
    },
    {
      "type": "header",
      "content": "Short description"
    },
    {
      "type": "richtext",
      "id": "short_description",
      "label": "Short description / highlights",
      "default": "<p>Introducing the <strong>all-new Bomber Synergy Edge</strong> — our most advanced cornhole bag ever. Patented Edge Technology stitching gives you two distinct playing surfaces for unmatched control, on any board and in any weather.</p>"
    },
    {
      "type": "header",
      "content": "Buy box"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart button label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "atc_sublabel",
      "label": "Add to cart sublabel",
      "default": "GET AN EDGE"
    },
    {
      "type": "checkbox",
      "id": "enable_payment_button",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show stock status",
      "default": true
    },
    {
      "type": "header",
      "content": "Complete Your Set"
    },
    {
      "type": "checkbox",
      "id": "enable_complete_your_set",
      "label": "Enable upsell column",
      "default": true
    },
    {
      "type": "text",
      "id": "complete_your_set_heading",
      "label": "Heading",
      "default": "COMPLETE YOUR SET"
    }
  ],
  "blocks": [
    {
      "type": "upsell_product",
      "name": "Upsell product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "trust_icon",
      "name": "Trust icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Shipping Over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Synergy Product",
      "category": "Product",
      "blocks": [
        { "type": "trust_icon", "settings": { "label": "FREE SHIPPING OVER $50" } },
        { "type": "trust_icon", "settings": { "label": "OFFICIALLY ACA APPROVED" } },
        { "type": "trust_icon", "settings": { "label": "30-DAY MONEY-BACK GUARANTEE" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
