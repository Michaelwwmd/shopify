{{ 'custom-synergy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-synergy.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section
  class="synergy-product"
  data-section-id="{{ section.id }}"
  data-section-type="main-product-synergy"
  style="
    background-color: {{ section.settings.bg_color }};
    --sp-bg: {{ section.settings.bg_color }};
    --sp-padding-top: {{ section.settings.padding_top }}px;
    --sp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sp-gap: {{ section.settings.column_gap }}px;
    --sp-title-size: {{ section.settings.title_font_size }}px;
    --sp-title-color: {{ section.settings.title_color }};
    --sp-title-weight: {{ section.settings.title_weight }};
    --sp-price-size: {{ section.settings.price_font_size }}px;
    --sp-price-color: {{ section.settings.price_color }};
    --sp-compare-color: {{ section.settings.compare_price_color }};
    --sp-installment-size: {{ section.settings.installment_font_size }}px;
    --sp-installment-color: {{ section.settings.installment_color }};
    --sp-star-color: {{ section.settings.star_color }};
    --sp-stock-in-color: {{ section.settings.stock_in_color }};
    --sp-stock-out-color: {{ section.settings.stock_out_color }};
    --sp-option-label-size: {{ section.settings.option_label_font_size }}px;
    --sp-option-label-color: {{ section.settings.option_label_color }};
    --sp-swatch-border-color: {{ section.settings.swatch_border_color }};
    --sp-swatch-active-color: {{ section.settings.swatch_active_color }};
    --sp-swatch-radius: {{ section.settings.swatch_border_radius }}px;
    --sp-qty-width: {{ section.settings.qty_input_width }}px;
    --sp-qty-height: {{ section.settings.qty_input_height }}px;
    --sp-atc-bg: {{ section.settings.atc_bg_color }};
    --sp-atc-color: {{ section.settings.atc_text_color }};
    --sp-atc-size: {{ section.settings.atc_font_size }}px;
    --sp-atc-radius: {{ section.settings.atc_border_radius }}px;
    --sp-atc-padding: {{ section.settings.atc_padding }}px;
    --sp-ribbon-bg: {{ section.settings.ribbon_bg_color }};
    --sp-ribbon-color: {{ section.settings.ribbon_text_color }};
    --sp-border-color: {{ section.settings.divider_color }};
    --sp-badge-bg: {{ section.settings.badge_bg_color }};
    --sp-badge-color: {{ section.settings.badge_text_color }};
  "
>
  <div class="synergy-product__wrapper page-width">
    {%- comment -%} ---- Gallery (main image + thumbs below) ---- {%- endcomment -%}
    <div class="synergy-product__gallery">
      <div class="synergy-gallery synergy-gallery--stacked" data-synergy-gallery>
        <div class="synergy-gallery__stage" data-synergy-stage>
          {%- if section.settings.image_badge_label != blank -%}
            <span class="synergy-gallery__badge">{{ section.settings.image_badge_label }}</span>
          {%- endif -%}

          <button type="button" class="synergy-gallery__zoom" aria-label="Zoom image">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="M21 21l-4.35-4.35"/>
            </svg>
          </button>

          {%- for media in product.media -%}
            <div
              class="synergy-gallery__slide{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'eager',
                      widths: '480, 720, 960, 1200, 1600',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      alt: media.alt | escape
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | image_url: width: 1200 | image_tag: alt: media.alt | escape }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="synergy-gallery__thumbs synergy-gallery__thumbs--row" data-synergy-thumbs>
          {%- for media in product.media -%}
            <button
              type="button"
              class="synergy-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ media.alt | default: product.title | escape }}"
            >
              {%- if media.media_type == 'image' -%}
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ---- Product Info ---- {%- endcomment -%}
    <div class="synergy-product__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="synergy-product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="synergy-product__title">{{ product.title | upcase }}</h1>

      {%- comment -%} ---- Price + installments + sku ---- {%- endcomment -%}
      <div class="synergy-product__price-block">
        <div class="synergy-product__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="synergy-product__price-compare">
              {{ current_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
          <span class="synergy-product__price-current" data-synergy-price>
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="synergy-product__price-save">
              Save
              {{- current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_installments -%}
          <p class="synergy-product__installments">
            Pay in 4 interest-free installments of
            <strong>{{ current_variant.price | divided_by: 4.0 | money }}</strong>
            with
            <span class="synergy-product__installments-brand">
              <svg viewBox="0 0 50 20" width="50" height="14" aria-hidden="true">
                <rect x="0" y="0" width="50" height="20" rx="4" fill="#5a31f4"/>
                <text x="25" y="14" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="700" fill="#ffffff">shop</text>
              </svg>
            </span>
            <a href="{{ section.settings.installment_link | default: '#' }}" class="synergy-product__installments-learn">Learn more</a>
          </p>
        {%- endif -%}

        {%- if section.settings.show_sku and current_variant.sku != blank -%}
          <p class="synergy-product__sku-line">SKU: {{ current_variant.sku }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Rating + stock ---- {%- endcomment -%}
      <div class="synergy-product__rating-stock">
        <div class="synergy-product__rating">
          <div class="synergy-stars" aria-label="Rated {{ section.settings.review_rating }} out of 5">
            <span class="synergy-stars__fill" style="width: {{ section.settings.review_rating | times: 20.0 }}%;"></span>
          </div>
          <a href="#synergy-reviews" class="synergy-product__rating-count">
            {{ section.settings.review_count_text }}
          </a>
        </div>

        {%- if section.settings.show_stock -%}
          {%- if current_variant.available -%}
            <p class="synergy-product__stock synergy-product__stock--in">In stock</p>
          {%- else -%}
            <p class="synergy-product__stock synergy-product__stock--out">Out of stock</p>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} ---- Variant form ---- {%- endcomment -%}
      {%- form 'product', product, class: 'synergy-product__form', id: 'synergy-product-form', novalidate: 'novalidate' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="synergy-product__option" data-option-index="{{ forloop.index0 }}">
              <label class="synergy-product__option-label">
                {{ option.name }}:
                <span class="synergy-product__option-value" data-option-value="{{ forloop.index0 }}">
                  {{ option.selected_value }}
                </span>
              </label>
              <div class="synergy-product__swatches" data-option-swatches>
                {%- for value in option.values -%}
                  {%- assign is_color = false -%}
                  {%- assign lower_name = option.name | downcase -%}
                  {%- if lower_name contains 'color' or lower_name contains 'colour' -%}
                    {%- assign is_color = true -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="synergy-swatch{% if option.selected_value == value %} is-active{% endif %}{% if is_color %} is-color{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-option-value="{{ value | escape }}"
                    {% if is_color %}style="background-color: {{ value | handle }};"{% endif %}
                    aria-label="{{ option.name }}: {{ value }}"
                  >
                    {%- unless is_color -%}{{ value }}{%- endunless -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <select name="id" class="synergy-product__variant-select" data-synergy-variant-select hidden>
          {%- for variant in product.variants -%}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected="selected"{% endif %}
              {% unless variant.available %}disabled{% endunless %}
              data-price="{{ variant.price | money }}"
              data-compare-price="{{ variant.compare_at_price | money }}"
              data-available="{{ variant.available }}"
            >
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>

        <div class="synergy-product__qty-wrapper">
          <label class="synergy-product__qty-label" for="synergy-quantity">Quantity:</label>
          <div class="synergy-qty-input">
            <button type="button" class="synergy-qty-input__btn" data-qty-action="decrement" aria-label="Decrease quantity">&minus;</button>
            <input
              type="number"
              id="synergy-quantity"
              name="quantity"
              value="1"
              min="1"
              class="synergy-qty-input__field"
              data-synergy-qty
            >
            <button type="button" class="synergy-qty-input__btn" data-qty-action="increment" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <div class="synergy-product__atc-wrapper">
          <button
            type="submit"
            name="add"
            class="synergy-product__atc btn"
            data-synergy-atc
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span class="synergy-product__atc-text">
              {%- if current_variant.available -%}
                {{ section.settings.atc_label | default: 'ADD TO CART' }}
              {%- else -%}
                SOLD OUT
              {%- endif -%}
            </span>
          </button>

          {%- if section.settings.discount_ribbon_label != blank -%}
            <div class="synergy-product__ribbon" data-synergy-ribbon>
              <span class="synergy-product__ribbon-text">{{ section.settings.discount_ribbon_label }}</span>
              <button type="button" class="synergy-product__ribbon-close" aria-label="Dismiss offer" data-synergy-ribbon-close>&times;</button>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_payment_button -%}
          <div class="synergy-product__dynamic-checkout">
            {{ form | payment_button }}
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} ---- Guaranteed Safe Checkout ---- {%- endcomment -%}
      {%- if section.settings.enable_safe_checkout -%}
        <div class="synergy-product__safe-checkout">
          <div class="synergy-product__safe-checkout-label">
            <span>{{ section.settings.safe_checkout_label }}</span>
          </div>
          <div class="synergy-product__safe-checkout-icons">
            {%- if section.settings.safe_checkout_icons != blank -%}
              {{ section.settings.safe_checkout_icons | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Safe checkout' }}
            {%- else -%}
              <ul class="synergy-payment-icons" aria-label="Accepted payment methods">
                <li class="synergy-payment-icons__item synergy-payment-icons__item--visa">VISA</li>
                <li class="synergy-payment-icons__item synergy-payment-icons__item--mc">mastercard</li>
                <li class="synergy-payment-icons__item synergy-payment-icons__item--amex">AMERICAN<br>EXPRESS</li>
                <li class="synergy-payment-icons__item synergy-payment-icons__item--disc">DISCOVER</li>
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---- Share row ---- {%- endcomment -%}
      {%- if section.settings.enable_share -%}
        {%- assign share_url = shop.url | append: product.url -%}
        {%- assign share_title = product.title | url_encode -%}
        <div class="synergy-product__share">
          <span class="synergy-product__share-label">Share</span>
          <a class="synergy-product__share-link" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.8c0-.9.25-1.5 1.5-1.5h1.6V4.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.1H8v3h2.5V21h3z"/></svg>
          </a>
          <a class="synergy-product__share-link" href="https://pinterest.com/pin/create/button/?url={{ share_url }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9.2-.8 1.2-5.2 1.2-5.2s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.4-2 3.4-4.9 0-2.6-1.9-4.4-4.5-4.4-3.1 0-4.9 2.3-4.9 4.7 0 .9.4 2 .8 2.5.1.1.1.2.1.3 0 .2-.2.8-.2 1-.1.2-.2.3-.5.2-1.7-.8-2.8-3.3-2.8-5.3 0-4.3 3.1-8.2 9-8.2 4.7 0 8.4 3.4 8.4 7.9 0 4.7-3 8.5-7.1 8.5-1.4 0-2.7-.7-3.1-1.6l-.9 3.2c-.3 1.2-1.2 2.7-1.8 3.7A10 10 0 1 0 12 2z"/></svg>
          </a>
          <a class="synergy-product__share-link" href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on X">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.2 3h2.8l-6 7 7 10h-6l-4.7-6.6L6 20H3l6.4-7.5L3 3h6l4.2 6L18.2 3zm-1 15.5h1.6L7.8 4.6H6.1L17.2 18.5z"/></svg>
          </a>
          <a class="synergy-product__share-link" href="mailto:?subject={{ share_title }}&body={{ share_url }}" aria-label="Share by email">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Synergy Product",
  "tag": "section",
  "class": "section-synergy-product",
  "settings": [
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 10, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "color", "id": "divider_color", "label": "Divider / border color", "default": "#e5e7eb" },

    { "type": "header", "content": "Gallery" },
    { "type": "text", "id": "image_badge_label", "label": "Gallery badge label", "info": "e.g. NEW, BEST SELLER. Leave blank to hide." },
    { "type": "color", "id": "badge_bg_color", "label": "Badge background", "default": "#007bff" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text color", "default": "#ffffff" },

    { "type": "header", "content": "Title" },
    { "type": "range", "id": "title_font_size", "label": "Title font size", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "select", "id": "title_weight", "label": "Title font weight", "options": [{ "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }, { "value": "900", "label": "Black" }], "default": "800" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#111111" },

    { "type": "header", "content": "Price" },
    { "type": "range", "id": "price_font_size", "label": "Price font size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "color", "id": "price_color", "label": "Price color", "default": "#111111" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at price color", "default": "#6c757d" },
    { "type": "checkbox", "id": "enable_installments", "label": "Show Shop Pay installment messaging", "default": true },
    { "type": "range", "id": "installment_font_size", "label": "Installment text font size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "color", "id": "installment_color", "label": "Installment text color", "default": "#333333" },
    { "type": "url", "id": "installment_link", "label": "\"Learn more\" link" },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": true },

    { "type": "header", "content": "Rating & stock" },
    { "type": "range", "id": "review_rating", "label": "Star rating", "min": 0, "max": 5, "step": 0.1, "default": 4.7 },
    { "type": "text", "id": "review_count_text", "label": "Review count text", "default": "137 reviews" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#f5a623" },
    { "type": "checkbox", "id": "show_stock", "label": "Show stock status", "default": true },
    { "type": "color", "id": "stock_in_color", "label": "In-stock color", "default": "#16a34a" },
    { "type": "color", "id": "stock_out_color", "label": "Out-of-stock color", "default": "#c0392b" },

    { "type": "header", "content": "Variant options" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "range", "id": "option_label_font_size", "label": "Option label font size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "color", "id": "option_label_color", "label": "Option label color", "default": "#111111" },
    { "type": "color", "id": "swatch_border_color", "label": "Swatch border color", "default": "#e5e7eb" },
    { "type": "color", "id": "swatch_active_color", "label": "Swatch active border color", "default": "#111111" },
    { "type": "range", "id": "swatch_border_radius", "label": "Swatch border radius", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 6 },

    { "type": "header", "content": "Quantity input" },
    { "type": "range", "id": "qty_input_width", "label": "Quantity input width", "min": 80, "max": 200, "step": 2, "unit": "px", "default": 120 },
    { "type": "range", "id": "qty_input_height", "label": "Quantity input height", "min": 30, "max": 50, "step": 1, "unit": "px", "default": 40 },

    { "type": "header", "content": "Add to cart button" },
    { "type": "text", "id": "atc_label", "label": "Button label", "default": "ADD TO CART" },
    { "type": "color", "id": "atc_bg_color", "label": "Button background", "default": "#007bff" },
    { "type": "color", "id": "atc_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "atc_font_size", "label": "Button font size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "atc_border_radius", "label": "Button border radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "atc_padding", "label": "Button vertical padding", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Discount ribbon" },
    { "type": "text", "id": "discount_ribbon_label", "label": "Ribbon label", "info": "Leave blank to hide.", "default": "GET 20% OFF" },
    { "type": "color", "id": "ribbon_bg_color", "label": "Ribbon background", "default": "#111111" },
    { "type": "color", "id": "ribbon_text_color", "label": "Ribbon text color", "default": "#ffffff" },

    { "type": "header", "content": "Dynamic checkout" },
    { "type": "checkbox", "id": "enable_payment_button", "label": "Show dynamic checkout button", "default": false },

    { "type": "header", "content": "Safe checkout" },
    { "type": "checkbox", "id": "enable_safe_checkout", "label": "Show Guaranteed Safe Checkout box", "default": true },
    { "type": "text", "id": "safe_checkout_label", "label": "Label", "default": "GUARANTEED SAFE CHECKOUT" },
    { "type": "image_picker", "id": "safe_checkout_icons", "label": "Payment icons image (optional)", "info": "Falls back to built-in Visa / MC / Amex / Discover chips." },

    { "type": "header", "content": "Share" },
    { "type": "checkbox", "id": "enable_share", "label": "Show share row", "default": true }
  ],
  "presets": [
    {
      "name": "Synergy Product",
      "category": "Product"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
