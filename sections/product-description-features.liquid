{%- comment -%}
  Product description + key features with tabs (left column) alongside
  the "Complete Your Set" upsell column (right column).
  All typography, colors, and spacing are customizable via the theme editor.
{%- endcomment -%}

<section
  class="synergy-description"
  data-section-id="{{ section.id }}"
  data-section-type="product-description-features"
  style="
    --sd-bg: {{ section.settings.bg_color }};
    --sd-padding-top: {{ section.settings.padding_top }}px;
    --sd-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sd-tab-size: {{ section.settings.tab_font_size }}px;
    --sd-tab-color: {{ section.settings.tab_color }};
    --sd-tab-active-color: {{ section.settings.tab_active_color }};
    --sd-tab-border-color: {{ section.settings.tab_active_color }};
    --sd-heading-size: {{ section.settings.heading_font_size }}px;
    --sd-heading-color: {{ section.settings.heading_color }};
    --sd-heading-weight: {{ section.settings.heading_weight }};
    --sd-sub-size: {{ section.settings.subheading_font_size }}px;
    --sd-sub-color: {{ section.settings.subheading_color }};
    --sd-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --sd-eyebrow-color: {{ section.settings.eyebrow_color }};
    --sd-body-size: {{ section.settings.body_font_size }}px;
    --sd-body-color: {{ section.settings.body_color }};
    --sd-body-line-height: {{ section.settings.body_line_height }};
    --sd-feat-heading-size: {{ section.settings.features_heading_font_size }}px;
    --sd-feat-heading-color: {{ section.settings.features_heading_color }};
    --sd-feat-size: {{ section.settings.feature_font_size }}px;
    --sd-feat-color: {{ section.settings.feature_color }};
    --sd-feat-check-color: {{ section.settings.feature_check_color }};
    --sd-feat-gap: {{ section.settings.feature_gap }}px;
    --sd-aside-heading-size: {{ section.settings.aside_heading_font_size }}px;
    --sd-aside-heading-color: {{ section.settings.aside_heading_color }};
  "
>
  <div class="synergy-description__layout page-width">
    {%- comment -%} ---- Left: tabs + description ---- {%- endcomment -%}
    <div class="synergy-description__main">
      {%- if section.settings.tabs_enabled -%}
        <div class="synergy-tabs" data-synergy-tabs>
          <button
            type="button"
            class="synergy-tabs__btn is-active"
            data-tab-target="default"
          >
            {{ section.settings.description_tab_label | upcase }}
          </button>
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                type="button"
                class="synergy-tabs__btn"
                data-tab-target="tab-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_label | upcase }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="synergy-description__panels">
        {%- comment -%} Default description panel {%- endcomment -%}
        <div class="synergy-description__panel is-active" data-tab-panel="default">
          <h2 class="synergy-description__heading">{{ section.settings.description_heading }}</h2>

          {%- if section.settings.description_subheading != blank -%}
            <p class="synergy-description__subheading">{{ section.settings.description_subheading }}</p>
          {%- endif -%}

          {%- if section.settings.description_eyebrow != blank -%}
            <p class="synergy-description__eyebrow">{{ section.settings.description_eyebrow }}</p>
          {%- endif -%}

          <div class="synergy-description__body rte">
            {%- if section.settings.description_body != blank -%}
              {{ section.settings.description_body }}
            {%- else -%}
              {{ product.description }}
            {%- endif -%}
          </div>

          {%- assign has_features = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}{%- assign has_features = true -%}{%- endif -%}
          {%- endfor -%}

          {%- if has_features -%}
            <h3 class="synergy-description__features-heading">{{ section.settings.features_heading }}</h3>
            <ul class="synergy-features">
              {%- for block in section.blocks -%}
                {%- if block.type == 'feature' -%}
                  <li class="synergy-features__item" {{ block.shopify_attributes }}>
                    <span class="synergy-features__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="14" height="14">
                        <circle cx="12" cy="12" r="10" fill="currentColor"/>
                        <path d="M17 9l-6 6-3-3" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="synergy-features__text">{{ block.settings.feature_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.closing_paragraph != blank -%}
            <div class="synergy-description__closing rte">
              {{ section.settings.closing_paragraph }}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Additional tab panels {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <div
              class="synergy-description__panel"
              id="tab-{{ block.id }}"
              data-tab-panel="tab-{{ block.id }}"
            >
              {{ block.settings.tab_content }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---- Right: Complete Your Set ---- {%- endcomment -%}
    {%- assign has_upsells = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'upsell_product' -%}{%- assign has_upsells = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_upsells and section.settings.enable_complete_your_set -%}
      <aside class="synergy-description__aside">
        <h3 class="synergy-description__aside-heading">
          {{ section.settings.complete_your_set_heading }}
        </h3>
        <div class="synergy-description__upsell-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'upsell_product' -%}
              {%- assign upsell = all_products[block.settings.product] -%}
              {%- if upsell != blank -%}
                {%- assign upsell_variant = upsell.selected_or_first_available_variant -%}
                <div class="synergy-upsell-card" {{ block.shopify_attributes }}>
                  <a href="{{ upsell.url }}" class="synergy-upsell-card__image">
                    {%- if upsell.featured_image -%}
                      {{ upsell.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: upsell.title | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                    {%- endif -%}
                  </a>
                  <div class="synergy-upsell-card__body">
                    <a href="{{ upsell.url }}" class="synergy-upsell-card__title">{{ upsell.title }}</a>
                    <div class="synergy-upsell-card__rating">
                      <div class="synergy-stars synergy-stars--sm">
                        <span class="synergy-stars__fill" style="width: {{ block.settings.rating | default: 5 | times: 20 }}%;"></span>
                      </div>
                      <span class="synergy-upsell-card__review-count">
                        {{ block.settings.review_count_text | default: upsell.metafields.reviews.rating_count }}
                      </span>
                    </div>
                    <p class="synergy-upsell-card__price">{{ upsell.price | money }}</p>
                    <form method="post" action="/cart/add" class="synergy-upsell-card__form">
                      <input type="hidden" name="id" value="{{ upsell_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="synergy-upsell-card__add" {% unless upsell_variant.available %}disabled{% endunless %}>+ Add to cart</button>
                    </form>
                  </div>
                </div>
              {%- else -%}
                <div class="synergy-upsell-card" {{ block.shopify_attributes }}>
                  <div class="synergy-upsell-card__image">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="synergy-upsell-card__body">
                    <p class="synergy-upsell-card__title">{{ block.settings.title }}</p>
                    <div class="synergy-upsell-card__rating">
                      <div class="synergy-stars synergy-stars--sm">
                        <span class="synergy-stars__fill" style="width: {{ block.settings.rating | default: 5 | times: 20 }}%;"></span>
                      </div>
                      <span class="synergy-upsell-card__review-count">{{ block.settings.review_count_text }}</span>
                    </div>
                    <p class="synergy-upsell-card__price">{{ block.settings.price }}</p>
                    <a href="{{ block.settings.link | default: '#' }}" class="synergy-upsell-card__add">+ Add to cart</a>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Synergy Description",
  "tag": "section",
  "class": "section-synergy-description",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "checkbox",
      "id": "tabs_enabled",
      "label": "Enable tabs row",
      "default": true
    },
    {
      "type": "text",
      "id": "description_tab_label",
      "label": "Description tab label",
      "default": "Description"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "Tab font size",
      "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Tab text color",
      "default": "#6c757d"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab / underline color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Description heading"
    },
    {
      "type": "text",
      "id": "description_heading",
      "label": "Main heading",
      "default": "BOMBER SYNERGY EDGE CORNHOLE BAGS"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 18, "max": 48, "step": 1, "unit": "px", "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "800"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Subheading / eyebrow"
    },
    {
      "type": "text",
      "id": "description_subheading",
      "label": "Subheading",
      "default": "BOMBER SYNERGY EDGE CORNHOLE BAGS – PROFESSIONAL DUAL-SIDED CORNHOLE BAGS WITH EDGE TECH"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "description_eyebrow",
      "label": "Eyebrow",
      "default": "OFFICIAL TOURNAMENT CORNHOLE BAGS – MADE & ENDORSED BY THE AMERICAN CORNHOLE ASSOCIATION"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow font size",
      "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "description_body",
      "label": "Description body",
      "info": "Falls back to the product.description if left blank.",
      "default": "<p>Take your cornhole game to the next level with Bomber Synergy Edge Cornhole Bags, featuring patented <strong>EDGE Tech construction</strong> (Patent Pending) for superior control, blocking, and shot accuracy.</p>"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "body_line_height",
      "label": "Body line height",
      "options": [
        { "value": "1.4", "label": "Tight (1.4)" },
        { "value": "1.6", "label": "Normal (1.6)" },
        { "value": "1.7", "label": "Relaxed (1.7)" },
        { "value": "1.9", "label": "Loose (1.9)" }
      ],
      "default": "1.7"
    },
    {
      "type": "header",
      "content": "Key features"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features heading",
      "default": "KEY FEATURES:"
    },
    {
      "type": "range",
      "id": "features_heading_font_size",
      "label": "Features heading font size",
      "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18
    },
    {
      "type": "color",
      "id": "features_heading_color",
      "label": "Features heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "feature_font_size",
      "label": "Feature bullet font size",
      "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "color",
      "id": "feature_color",
      "label": "Feature text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "feature_check_color",
      "label": "Checkmark color",
      "default": "#16a34a"
    },
    {
      "type": "range",
      "id": "feature_gap",
      "label": "Spacing between features",
      "min": 4, "max": 24, "step": 2, "unit": "px", "default": 12
    },
    {
      "type": "richtext",
      "id": "closing_paragraph",
      "label": "Closing paragraph",
      "default": "<p><strong>Designed for players of all levels,</strong> Synergy Edge Cornhole Bags bring professional performance to backyard games, tournaments, and competitive play.</p>"
    },
    {
      "type": "header",
      "content": "Complete Your Set"
    },
    {
      "type": "checkbox",
      "id": "enable_complete_your_set",
      "label": "Show Complete Your Set column",
      "default": true
    },
    {
      "type": "text",
      "id": "complete_your_set_heading",
      "label": "Heading",
      "default": "COMPLETE YOUR SET"
    },
    {
      "type": "range",
      "id": "aside_heading_font_size",
      "label": "Aside heading font size",
      "min": 14, "max": 36, "step": 1, "unit": "px", "default": 22
    },
    {
      "type": "color",
      "id": "aside_heading_color",
      "label": "Aside heading color",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature bullet",
      "settings": [
        { "type": "text", "id": "feature_text", "label": "Feature text", "default": "Officially approved cornhole bags by the American Cornhole Association (ACA)" }
      ]
    },
    {
      "type": "upsell_product",
      "name": "Upsell product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 0.1, "default": 4.8 },
        { "type": "text", "id": "review_count_text", "label": "Review count text", "default": "31 reviews" },
        { "type": "header", "content": "Fallback (if no product selected)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "tab",
      "name": "Extra tab",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Specs" },
        { "type": "richtext", "id": "tab_content", "label": "Tab content", "default": "<p>Add your tab content here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Synergy Description",
      "category": "Product",
      "blocks": [
        { "type": "feature", "settings": { "feature_text": "Officially approved cornhole bags by the American Cornhole Association (ACA)" } },
        { "type": "feature", "settings": { "feature_text": "Designed for precision and consistency, Bomber Synergy Edge cornhole bags offer a reliable feel and standout style on the boards." } },
        { "type": "feature", "settings": { "feature_text": "Dual-sided performance: Grip with microsuede, slide with poly turbo weave" } },
        { "type": "feature", "settings": { "feature_text": "EDGE Tech patented construction enhances blocking, pushing, and control" } },
        { "type": "feature", "settings": { "feature_text": "Flat design for even filling dispersion – no more unpredictable landings" } },
        { "type": "feature", "settings": { "feature_text": "Resin-filled for all-weather durability – lasts longer than traditional cornhole bags" } },
        { "type": "feature", "settings": { "feature_text": "Double reinforced stitching ensures a long-lasting, tournament-quality build" } },
        { "type": "feature", "settings": { "feature_text": "Regulation size & weight: 6in x 6in and ACA-compliant" } },
        { "type": "tab", "settings": { "tab_label": "Specs" } },
        { "type": "tab", "settings": { "tab_label": "Scale" } }
      ]
    }
  ]
}
{% endschema %}
