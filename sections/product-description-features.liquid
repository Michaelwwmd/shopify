{%- comment -%}
  Product description + key features with tabs (left column) alongside
  the "Complete Your Set" upsell column (right column).
{%- endcomment -%}

<section
  class="synergy-description"
  data-section-id="{{ section.id }}"
  data-section-type="product-description-features"
>
  <div class="synergy-description__layout page-width">
    {%- comment -%} ---- Left: tabs + description ---- {%- endcomment -%}
    <div class="synergy-description__main">
      {%- if section.settings.tabs_enabled -%}
        <div class="synergy-tabs" data-synergy-tabs>
          <button
            type="button"
            class="synergy-tabs__btn is-active"
            data-tab-target="default"
          >
            {{ section.settings.description_tab_label | upcase }}
          </button>
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                type="button"
                class="synergy-tabs__btn"
                data-tab-target="tab-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_label | upcase }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="synergy-description__panels">
        {%- comment -%} Default description panel {%- endcomment -%}
        <div class="synergy-description__panel is-active" data-tab-panel="default">
          <h2 class="synergy-description__heading">{{ section.settings.description_heading }}</h2>

          {%- if section.settings.description_subheading != blank -%}
            <p class="synergy-description__subheading">{{ section.settings.description_subheading }}</p>
          {%- endif -%}

          {%- if section.settings.description_eyebrow != blank -%}
            <p class="synergy-description__eyebrow">{{ section.settings.description_eyebrow }}</p>
          {%- endif -%}

          <div class="synergy-description__body rte">
            {%- if section.settings.description_body != blank -%}
              {{ section.settings.description_body }}
            {%- else -%}
              {{ product.description }}
            {%- endif -%}
          </div>

          {%- assign has_features = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}{%- assign has_features = true -%}{%- endif -%}
          {%- endfor -%}

          {%- if has_features -%}
            <h3 class="synergy-description__features-heading">{{ section.settings.features_heading }}</h3>
            <ul class="synergy-features">
              {%- for block in section.blocks -%}
                {%- if block.type == 'feature' -%}
                  <li class="synergy-features__item" {{ block.shopify_attributes }}>
                    <span class="synergy-features__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="14" height="14">
                        <circle cx="12" cy="12" r="10" fill="currentColor"/>
                        <path d="M17 9l-6 6-3-3" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="synergy-features__text">{{ block.settings.feature_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.closing_paragraph != blank -%}
            <div class="synergy-description__closing rte">
              {{ section.settings.closing_paragraph }}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Additional tab panels {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <div
              class="synergy-description__panel"
              id="tab-{{ block.id }}"
              data-tab-panel="tab-{{ block.id }}"
            >
              {{ block.settings.tab_content }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---- Right: Complete Your Set ---- {%- endcomment -%}
    {%- assign has_upsells = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'upsell_product' -%}{%- assign has_upsells = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_upsells and section.settings.enable_complete_your_set -%}
      <aside class="synergy-description__aside">
        <h3 class="synergy-description__aside-heading">
          {{ section.settings.complete_your_set_heading }}
        </h3>
        <div class="synergy-description__upsell-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'upsell_product' -%}
              {%- assign upsell = all_products[block.settings.product] -%}
              {%- if upsell != blank -%}
                {%- assign upsell_variant = upsell.selected_or_first_available_variant -%}
                <div class="synergy-upsell-card" {{ block.shopify_attributes }}>
                  <a href="{{ upsell.url }}" class="synergy-upsell-card__image">
                    {%- if upsell.featured_image -%}
                      {{ upsell.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: upsell.title | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                    {%- endif -%}
                  </a>
                  <div class="synergy-upsell-card__body">
                    <a href="{{ upsell.url }}" class="synergy-upsell-card__title">{{ upsell.title }}</a>
                    <div class="synergy-upsell-card__rating">
                      <div class="synergy-stars synergy-stars--sm">
                        <span class="synergy-stars__fill" style="width: {{ block.settings.rating | default: 5 | times: 20 }}%;"></span>
                      </div>
                      <span class="synergy-upsell-card__review-count">
                        {{ block.settings.review_count_text | default: upsell.metafields.reviews.rating_count }}
                      </span>
                    </div>
                    <p class="synergy-upsell-card__price">{{ upsell.price | money }}</p>
                    <form
                      method="post"
                      action="/cart/add"
                      class="synergy-upsell-card__form"
                    >
                      <input type="hidden" name="id" value="{{ upsell_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button
                        type="submit"
                        class="synergy-upsell-card__add"
                        {% unless upsell_variant.available %}disabled{% endunless %}
                      >
                        + Add to cart
                      </button>
                    </form>
                  </div>
                </div>
              {%- else -%}
                {%- comment -%} Placeholder card when no product is linked {%- endcomment -%}
                <div class="synergy-upsell-card" {{ block.shopify_attributes }}>
                  <div class="synergy-upsell-card__image">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="synergy-upsell-card__body">
                    <p class="synergy-upsell-card__title">{{ block.settings.title }}</p>
                    <div class="synergy-upsell-card__rating">
                      <div class="synergy-stars synergy-stars--sm">
                        <span class="synergy-stars__fill" style="width: {{ block.settings.rating | default: 5 | times: 20 }}%;"></span>
                      </div>
                      <span class="synergy-upsell-card__review-count">
                        {{ block.settings.review_count_text }}
                      </span>
                    </div>
                    <p class="synergy-upsell-card__price">{{ block.settings.price }}</p>
                    <a href="{{ block.settings.link | default: '#' }}" class="synergy-upsell-card__add">+ Add to cart</a>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Synergy Description",
  "tag": "section",
  "class": "section-synergy-description",
  "settings": [
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "checkbox",
      "id": "tabs_enabled",
      "label": "Enable tabs row",
      "default": true
    },
    {
      "type": "text",
      "id": "description_tab_label",
      "label": "Description tab label",
      "default": "Description"
    },
    {
      "type": "header",
      "content": "Description content"
    },
    {
      "type": "text",
      "id": "description_heading",
      "label": "Main heading",
      "default": "BOMBER SYNERGY EDGE CORNHOLE BAGS"
    },
    {
      "type": "text",
      "id": "description_subheading",
      "label": "Subheading",
      "default": "BOMBER SYNERGY EDGE CORNHOLE BAGS – PROFESSIONAL DUAL-SIDED CORNHOLE BAGS WITH EDGE TECH"
    },
    {
      "type": "text",
      "id": "description_eyebrow",
      "label": "Eyebrow",
      "default": "OFFICIAL TOURNAMENT CORNHOLE BAGS – MADE & ENDORSED BY THE AMERICAN CORNHOLE ASSOCIATION"
    },
    {
      "type": "richtext",
      "id": "description_body",
      "label": "Description body",
      "info": "Falls back to the product.description if left blank.",
      "default": "<p>Take your cornhole game to the next level with Bomber Synergy Edge Cornhole Bags, featuring patented <strong>EDGE Tech construction</strong> (Patent Pending) for superior control, blocking, and shot accuracy. These dual-sided, regulation-size cornhole bags are designed for both precision and speed, with a <strong>microsuede slow side</strong> for grip and a <strong>poly turbo weave fast side</strong> for smooth slides. The innovative three-piece construction creates a flatter landing surface for <strong>even weight distribution</strong>, improving shot consistency. Show off your bold style with the Bomber Synergy Edge cornhole bags, featuring a striking design that brings attitude to every toss.</p>"
    },
    {
      "type": "header",
      "content": "Key features"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features heading",
      "default": "KEY FEATURES:"
    },
    {
      "type": "richtext",
      "id": "closing_paragraph",
      "label": "Closing paragraph",
      "default": "<p><strong>Designed for players of all levels,</strong> Synergy Edge Cornhole Bags bring professional performance to backyard games, tournaments, and competitive play. Whether you're blocking your opponent or landing the perfect airmail shot, these innovative cornhole bags deliver precision, durability, and unmatched gameplay.</p>"
    },
    {
      "type": "header",
      "content": "Complete Your Set"
    },
    {
      "type": "checkbox",
      "id": "enable_complete_your_set",
      "label": "Show Complete Your Set column",
      "default": true
    },
    {
      "type": "text",
      "id": "complete_your_set_heading",
      "label": "Heading",
      "default": "COMPLETE YOUR SET"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature bullet",
      "settings": [
        {
          "type": "text",
          "id": "feature_text",
          "label": "Feature text",
          "default": "Officially approved cornhole bags by the American Cornhole Association (ACA)"
        }
      ]
    },
    {
      "type": "upsell_product",
      "name": "Upsell product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 4.8
        },
        {
          "type": "text",
          "id": "review_count_text",
          "label": "Review count text",
          "default": "31 reviews"
        },
        {
          "type": "header",
          "content": "Fallback (if no product selected)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Extra tab (optional)",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Specs"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab content",
          "default": "<p>Add your tab content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Synergy Description",
      "category": "Product",
      "blocks": [
        { "type": "feature", "settings": { "feature_text": "Officially approved cornhole bags by the American Cornhole Association (ACA)" } },
        { "type": "feature", "settings": { "feature_text": "Designed for precision and consistency, Bomber Synergy Edge cornhole bags offer a reliable feel and standout style on the boards." } },
        { "type": "feature", "settings": { "feature_text": "Dual-sided performance: Grip with microsuede, slide with poly turbo weave" } },
        { "type": "feature", "settings": { "feature_text": "EDGE Tech patented construction enhances blocking, pushing, and control" } },
        { "type": "feature", "settings": { "feature_text": "Flat design for even filling dispersion – no more unpredictable landings" } },
        { "type": "feature", "settings": { "feature_text": "Resin-filled for all-weather durability – lasts longer than traditional cornhole bags" } },
        { "type": "feature", "settings": { "feature_text": "Double reinforced stitching ensures a long-lasting, tournament-quality build" } },
        { "type": "feature", "settings": { "feature_text": "Regulation size & weight: 6in x 6in and ACA-compliant" } },
        { "type": "tab", "settings": { "tab_label": "Specs" } },
        { "type": "tab", "settings": { "tab_label": "Scale" } }
      ]
    }
  ]
}
{% endschema %}
